# Buddy environment (dummy values only — never commit real keys).
# Copy to .env locally. Production: set these in the host secret store.
#
# After removing .env from the git *index*, rotate the live Supabase
# anon/publishable key. Do NOT rewrite git history on this public repo to
# purge the old blob — rotate the key instead. Copy this file to .env locally.
# Never commit real keys.

# --- App origin ---
# Production canonical host. Also add this origin to the Supabase Auth redirect
# allow-list, OAuth apps (Oura/Polar/Garmin/Google), and CORS.
BUDDY_APP_BASE_URL=https://buddy.peakmovement.co.za
VITE_BUDDY_APP_BASE_URL=https://buddy.peakmovement.co.za

# --- Supabase (anon / publishable is client-safe; service role is server-only) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_replace_me
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Local seed scripts only (scripts/seed-*.ts). Do not use in production app code.
SEED_SERVICE_ROLE_KEY=

# --- Cron ---
CRON_SECRET=replace-with-long-random-string

# --- AI ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
LOVABLE_API_KEY=

# --- Email ---
RESEND_API_KEY=
BUDDY_EMAIL_FROM=Buddy <noreply@buddy-health.co.za>

# --- Wearables ---
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=
OURA_WEBHOOK_VERIFICATION_TOKEN=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_REDIRECT_URI=

# --- Google Calendar ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# --- Push ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Other ---
ALERT_ACTION_SECRET=
ALLOWED_ORIGINS=https://buddy.peakmovement.co.za,https://peakbuddy.lovable.app,http://localhost:5173
VITE_SUPPORT_WEBHOOK_URL=
